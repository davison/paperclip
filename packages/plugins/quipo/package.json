{
  "name": "@paperclipai/plugin-quipo",
  "version": "0.1.0-rc.1",
  "type": "module",
  "description": "Quipo: cross-issue memory plugin for Paperclip — extracts and stores facts, session summaries, and peer models so other agents can recall them.",
  "homepage": "https://github.com/paperclipai/paperclip",
  "bugs": {
    "url": "https://github.com/paperclipai/paperclip/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paperclipai/paperclip",
    "directory": "packages/plugins/quipo"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./prompts": {
      "types": "./dist/lib/prompts/extract-facts.d.ts",
      "import": "./dist/lib/prompts/extract-facts.js"
    },
    "./agent-templates/memory-worker": {
      "types": "./dist/lib/agent-templates/memory-worker/template.d.ts",
      "import": "./dist/lib/agent-templates/memory-worker/template.js"
    },
    "./manifest": {
      "types": "./dist/lib/manifest.d.ts",
      "import": "./dist/lib/manifest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "src/agent-templates",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "node ./esbuild.config.mjs && tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "memory",
    "quipo"
  ],
  "author": "Paperclip",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@paperclipai/shared": "workspace:*",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.27.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
